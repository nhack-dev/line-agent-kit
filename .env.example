# scripts/ が読む値。cp .env.example .env して入れる。.env は git に入れない（.gitignore 済み）
# Worker 側には同じ値を npx wrangler secret put で入れる（.env は Worker には届かない）

# LINE Developers > チャネル > Messaging API設定 > チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Developers > チャネル > チャネル基本設定 > チャネルシークレット
LINE_CHANNEL_SECRET=
# npx wrangler deploy のあとに出る URL（例 https://line-agent-kit.<あなたのサブドメイン>.workers.dev）
WORKER_URL=
# 管理用の合言葉。自分で作る: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# 決済（Stripe）を使うときだけ。Stripe > 開発者 > Webhook > 署名シークレット（whsec_...）
STRIPE_WEBHOOK_SECRET=

# 手元の試しだけ: にせ LINE API（scripts/mock_line_api.py）に向けるとき
# LINE_API_BASE=http://127.0.0.1:8790
# LINE_DATA_API_BASE=http://127.0.0.1:8790
